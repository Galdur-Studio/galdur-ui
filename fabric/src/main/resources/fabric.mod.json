{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "client": ["com.galdurstudio.galdurui.fabric.GaldurUIFabricClient"],
    "modmenu": ["com.galdurstudio.galdurui.fabric.GaldurModMenu"],
    "jei_mod_plugin": ["com.galdurstudio.galdurui.internal.compat.jei.GaldurJeiPlugin"],
    "emi": ["com.galdurstudio.galdurui.internal.compat.emi.GaldurEmiPlugin"]
  },
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-resource-loader-v0": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
