{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": ["${mod_authors}"],
  "license": "${mod_license}",
  "icon": "galdurui.png",
  "contact": {
    "homepage": "https://galdurstudio.com/mods/galdur-ui",
    "sources": "https://github.com/Galdur-Studio/galdur-ui",
    "issues": "https://github.com/Galdur-Studio/galdur-ui/issues"
  },
  "environment": "*",
  "accessWidener": "galdurui.accesswidener",
  "entrypoints": {
    "client": ["com.galdurstudio.galdurui.fabric.GaldurUIFabricClient"],
    "modmenu": ["com.galdurstudio.galdurui.fabric.GaldurModMenu"],
    "jei_mod_plugin": ["com.galdurstudio.galdurui.internal.compat.jei.GaldurJeiPlugin"],
    "emi": ["com.galdurstudio.galdurui.internal.compat.emi.GaldurEmiPlugin"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-resource-loader-v0": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  }
}
